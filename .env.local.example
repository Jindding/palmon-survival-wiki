# Supabase (자유게시판)
# 위치: Supabase 대시보드 → Project Settings → API Keys
#
# 브라우저에서 사용하는 공개 키 (RLS로 보호됨, 노출 OK)
#   ├─ 예전 이름: anon key           (eyJhbGciOi... JWT 형식)
#   └─ 새 이름:   publishable key    (sb_publishable_... 형식)
# 반드시 위 둘 중 하나를 사용. secret key(sb_secret_...)는 절대 여기 넣지 말 것.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXXXXXXXXXXXXXX

# ===== 관리자 도구 (/admin) =====
# 관리자 페이지 진입 비밀번호. 아무 문자열이나 길게 잡으면 된다.
ADMIN_PASSWORD=

# RLS를 우회하는 관리자 키. 절대 공개 금지. anon 키로는 대체할 수 없다
# (팁 삭제와 Storage 파일 삭제 정책이 anon에게 열려 있지 않기 때문).
# NEXT_PUBLIC_ 접두사를 붙이면 브라우저로 새어 나가니 붙이지 말 것.
#
# 둘 중 하나만 채우면 된다. 새로 만든다면 위쪽(Secret key)을 권장.
#   Supabase 대시보드 → Project Settings → API Keys → Secret keys → Create
SUPABASE_SECRET_KEY=
#   구형 방식: Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=
